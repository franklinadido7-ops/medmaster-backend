# ─── Copiez ce fichier en ".env" et remplissez vos clés ────────────────────────

# Sécurité (générez une chaîne aléatoire longue, ex: openssl rand -hex 32)
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire

# Base de données (laisser tel quel avec Docker Compose)
DATABASE_URL=postgresql://medmaster:medmaster_password_change_me@postgres:5432/medmaster

# Qdrant (laisser tel quel avec Docker Compose)
QDRANT_URL=http://qdrant:6333

# IA — Anthropic Claude (génération de fiches/flashcards/QCM/assistant)
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# IA — OpenAI (uniquement utilisé pour les embeddings du RAG)
OPENAI_API_KEY=sk-votre-cle-ici

# Stockage des fichiers (local par défaut, S3/R2 en option pour la prod)
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# Optionnel — Cloudflare R2 / Amazon S3 (laisser vide si STORAGE_BACKEND=local)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
